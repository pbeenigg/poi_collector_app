{
  "name": "poi-collector-app",
  "version": "1.0.0",
  "description": "POI 数据采集应用",
  "main": "dist/main/index.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\" \"npm run dev:main\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:preload": "webpack --config webpack.preload.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:all": "npm run build && ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true electron-builder -mwl",
    "build:mac": "npm run build && ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true electron-builder --mac",
    "build:win": "npm run build && ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true electron-builder --win",
    "build:linux": "npm run build && ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true electron-builder --linux",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.7.0",
    "csv-parser": "^3.0.0",
    "csv-stringify": "^6.5.0",
    "date-fns": "^4.1.0",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.23.26",
    "lodash": "^4.17.21",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.1.0",
    "react-router-dom": "^7.1.1",
    "react-spring": "^10.0.3",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12",
    "eslint": "^8.55.0",
    "events": "^3.3.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.0",
    "postcss-loader": "^8.1.0",
    "prettier": "^3.1.0",
    "process": "^0.11.10",
    "sass": "^1.97.1",
    "sass-loader": "^13.3.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "build": {
    "appId": "com.poi.collector",
    "productName": "POI数据采集器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "assets/images/logo.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "default",
          "arch": "arm64"
        }
      ]
    },
    "win": {
      "icon": "assets/images/logo.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/images/logo.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
